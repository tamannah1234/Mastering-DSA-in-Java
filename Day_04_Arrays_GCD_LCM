import java.util.*;

/*******************: Find GCD and LCM of two numbers***********************/

public class Main {
    public static int gcdOfNums(int n1,int n2){
      
    while(n2 !=0){
      int temp = n2;
      n2 = n1 % n2;
      n1=temp;
    } 
    return n1;
    }
    public static int lcmOfNums(int n1,int n2){
      return (n1*n2)/gcdOfNums(n1,n2);
    }
    public static void main(String[] args) {
      int n1=12,n2=18;
      int res = gcdOfNums(n1,n2);
      int res2 = lcmOfNums(n1,n2);
      
      System.out.println(res); 
      System.out.println(res2);

}

  }



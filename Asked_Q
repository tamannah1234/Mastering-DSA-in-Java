import java.util.*;

public class ValidGCDSequences {

    // Method to calculate GCD using Euclidean algorithm
    public static int GCD(int a, int b) {
        if (b == 0) return a;
        return GCD(b, a % b);
    }

    // Method to count valid sequences
    public static int countValidSequences(List<int[]> A, List<int[]> Z) {
        int validCount = 0;
        int n = A.size();

        for (int i = 0; i < n; i++) {
            int[] pairA = A.get(i);
            int[] pairZ = Z.get(i);

            int gcdA = GCD(pairA[0], pairA[1]);
            int gcdZ = GCD(pairZ[0], pairZ[1]);

            if (gcdA == gcdZ) {
                validCount++;
            }
        }

        return validCount;
    }

    public static void main(String[] args) {
        // Input as list of integer arrays
        List<int[]> A = new ArrayList<>();
        A.add(new int[]{1, 2});
        A.add(new int[]{1, 1});

        List<int[]> Z = new ArrayList<>();
        Z.add(new int[]{1, 2});
        Z.add(new int[]{2, 1});

        int result = countValidSequences(A, Z);
        System.out.println("Number of valid sequences: " + result);
    }
}


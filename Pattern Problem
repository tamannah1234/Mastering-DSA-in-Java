import java.util.*;;
public class AdvancePattern {
private static void pattern18(int n){
   for(int i=1;i<=n;i++){
      //Create spaces
         for(int j=1;j<=n-i;j++){
           System.out.print(" "); 
         }   
      //print character
      //Incresing fashion
      for(char ch = 'A';ch<='A'+i-1;ch++){
         System.out.print(ch);
      }
      //Decresing fashion
      for(int j=i-1;j>=1;j--){
        char ch = (char) ('A'+(j-1));
        System.out.print(ch);
      }
      //Create Spaces
       for(int j=1;j<=n-i;j++){
           System.out.print(" "); 
         } 
      System.out.println();
      }
 }
   public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      int n = sc.nextInt();
      // pattern12(n);
      pattern18(n);

      sc.close();
   }
}




//Find Subarray with K sum 

public class L_Arr_PrefixSum {
    public static int[] findPrefixSum(int []arr,int n,int []prefixSum){
        prefixSum[0]= arr[0];
        for(int i=1;i<n;i++){
            prefixSum[i]=prefixSum[i-1]+arr[i];
        }
        return prefixSum;
    }

    public static int sumRange(int []prefixSum,int L,int R){
        if(L==0) return prefixSum[R];
        return prefixSum[R]-prefixSum[L-1];
    }
    public static void main(String[] args) {
        int []arr = {0,1,2,3,4,5,6};
        int n = arr.length;
        int prefixSum[] = new int [n];
        int[]val =findPrefixSum(arr,n,prefixSum);
        for(int ele : val){
          System.out.println(ele);
        }
      System.out.println("Result "+sumRange(prefixSum,0,2)); 
     System.out.println("Result "+sumRange(prefixSum,1,1)); 
    }
}

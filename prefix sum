import java.util.HashSet;
import java.util.Set;

public class L_Arr_PrefixSumType3 {
    public static boolean hasSubarrayWithSumK(int[] arr, int k) {
        Set<Integer> set = new HashSet<>();
        int prefixSum = 0;
        set.add(0); // Important for exact match

        for (int num : arr) {
            prefixSum += num;
            if (set.contains(prefixSum - k)) return true;
            set.add(prefixSum);
        }

        return false;
    }

    public static void main(String[] args) {
        int[] arr = {1, 4, 20, 3, 10, 5};
        int k = 33;
        System.out.println(hasSubarrayWithSumK(arr, k)); // true (20+3+10)
    }
}      

